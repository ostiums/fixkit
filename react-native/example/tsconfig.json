{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // For TypeScript only (app.json turns these paths off for Metro): the package's sources one
    // folder up, checked against this app's React and React Native types.
    "paths": {
      "fixkit": ["../src"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx"]
}
